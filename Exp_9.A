    {
      "cell_type": "code",
      "source": [
        "word_index = imdb.get_word_index()\n",
        "\n",
        "def predict_sentiment(review):\n",
        "\n",
        "    words = review.lower().split()\n",
        "\n",
        "    sequence = [1]\n",
        "\n",
        "    for word in words:\n",
        "        index = word_index.get(word, 2) + 3\n",
        "\n",
        "        if index >= vocab_size:\n",
        "            index = 2\n",
        "\n",
        "        sequence.append(index)\n",
        "\n",
        "    padded = pad_sequences(\n",
        "        [sequence],\n",
        "        maxlen=max_length,\n",
        "        padding='post',\n",
        "        truncating='post'\n",
        "    )\n",
        "\n",
        "    prediction = gru_model.predict(padded, verbose=0)[0][0]\n",
        "\n",
        "    if prediction >= 0.5:\n",
        "        print(\"Positive Review\")\n",
        "    else:\n",
        "        print(\"Negative Review\")\n",
        "\n",
        "    print(\"Sentiment Score:\", round(float(prediction), 4))\n",
        "\n",
        "\n",
        "predict_sentiment(\n",
        "    \"This movie is excellent and wonderful. I really enjoyed it\"\n",
        ")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
